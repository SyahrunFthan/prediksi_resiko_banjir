      <operator activated="true" class="blending:generate_columns" compatibility="12.1.001" expanded="true" height="82" name="Generate Attributes" width="90" x="313" y="85">
        <list key="function_descriptions">
          <parameter key="risk_score" value="(min(curah_hujan_mm / 100, 1) * 0.35) + (min(hujan_3hari_sebelumnya_mm / 150, 1) * 0.25) + (min(hujan_7hari_sebelumnya_mm / 250, 1) * 0.15) + (min(durasi_hujan_jam / 24, 1) * 0.15) + ((kelembapan_rata2_pct / 100) * 0.10)"/>
          <parameter key="risk_category" value="if(risk_score &lt; 0.35, &quot;Rendah&quot;, if(risk_score &lt;= 0.65, &quot;Sedang&quot;, &quot;Tinggi&quot;))"/>
        </list>
        <parameter key="keep_all_columns" value="true"/>
        <parameter key="default_time_zone" value="Asia/Makassar"/>
      </operator>
